  <path class="box draw-me" d={box(700, 268, 265, 58)} /><text class="s" x="832" y="290" text-anchor="middle">PDE residuals, nondimensional</text><text class="s" x="832" y="308" text-anchor="middle">mass · momentum · mechanical energy</text>
  <path class="d" d="M600 232 H660 V299 H700" />
  <text class="s" x="606" y="224">features ⊕ ξ</text>

  <text class="s o" x="20" y="382">composite loss</text>
  <path class="box draw-me" d={box(20, 392, 190, 50)} /><text class="s" x="115" y="414" text-anchor="middle">data loss</text><text class="s" x="115" y="431" text-anchor="middle">focal + diameter + location</text>
  <path class="box draw-me" d={box(222, 392, 150, 50)} /><text class="s" x="297" y="414" text-anchor="middle">domain loss</text><text class="s" x="297" y="431" text-anchor="middle">BCE</text>
  <path class="box draw-me" d={box(384, 392, 150, 50)} /><text class="s" x="459" y="414" text-anchor="middle">residual loss</text><text class="s" x="459" y="431" text-anchor="middle">Σ ℛ²</text>
  <path class="d" d="M254 340 V392" /><path class="d" d="M584 340 V370 H297 V392" /><path class="d" d="M832 326 V370 H459 V392" />
  <path class="draw-me o" d="M115 442 V466 H277" /><path class="draw-me o" d="M297 442 V466" /><path class="draw-me o" d="M459 442 V466 H277" />
  <path class="box draw-me" d={box(197, 466, 160, 44)} /><text class="s" x="277" y="493" text-anchor="middle">training objective</text>

  <path class="d" d="M20 540 H960" />
  <text class="s" x="20" y="533">stratified 5-fold cross-validation</text>
  <text class="n" x="20" y="588">{v('Leak detection F1')}</text><text class="s" x="20" y="608">detection F1</text>
  <text class="n" x="230" y="588">{v('Diameter R2')}</text><text class="s" x="230" y="608">diameter R²</text>
  <text class="n" x="440" y="588">{v('Location R2')}</text><text class="s" x="440" y="608">location R², 16.5% over the best classical baseline</text>
</svg>
