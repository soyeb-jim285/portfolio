---
// The paper's Figure 4 as two parallel paths — the data path down the left, the physics path
// down the right — meeting in the composite objective. Same structure, no crossing lines.
import { research } from '../../data/content';
const box = (x: number, y: number, w: number, h: number) => `M${x} ${y}h${w}v${h}h${-w}z`;
const r = research.find((x) => x.slug === 'pce-pinn-pipelines')!.results;
const v = (label: string) => r.find((x) => x.label === label)?.value ?? '';

const heads = [
  { name: 'leak', spec: '64 → 24 → 1' },
  { name: 'diameter', spec: '64 → 32 → 1' },
  { name: 'location', spec: '3-zone attn' },
  { name: 'domain', spec: 'GRL, ∇→−λ∇' },
];
---
<svg class="diag draw r" viewBox="0 0 900 530" role="img" aria-label="PCE-PINN: a data path down the left from 27 features through a shared tanh trunk to four task heads and the data loss, a physics path down the right from boundary interpolation through the physics net and field construction to the nondimensional PDE residuals and their penalty, both meeting in one composite objective">
  <g data-lane="data">
  <text class="s o" x="20" y="22">data path</text>
  <path class="box draw-me" d={box(20, 30, 400, 48)} /><text class="s" x="220" y="50" text-anchor="middle">27 features</text><text class="s" x="220" y="67" text-anchor="middle">12 raw inputs + 15 engineered, robust-scaled</text>
  <path class="draw-me o" d="M220 78 V98" />
  <path class="box draw-me" d={box(20, 98, 400, 48)} /><text class="s" x="220" y="118" text-anchor="middle">shared trunk</text><text class="s" x="220" y="135" text-anchor="middle">27 → 64, tanh</text>

  <path class="draw-me o" d="M220 146 V166" />
  <path class="draw-me o" d="M66 166 H360" />
  {heads.map((head, i) => (
    <>
      <path class="draw-me o" d={`M${66 + i * 98} 166 V186`} />
      <path class="box draw-me" d={box(20 + i * 98, 186, 92, 54)} />
      <text class="s" x={66 + i * 98} y="208" text-anchor="middle">{head.name}</text>
      <text class="s" x={66 + i * 98} y="226" text-anchor="middle">{head.spec}</text>
    </>
  ))}

  <path class="draw-me o" d="M220 240 V286" />
  <path class="box draw-me" d={box(20, 286, 400, 48)} /><text class="s" x="220" y="306" text-anchor="middle">data loss</text><text class="s" x="220" y="323" text-anchor="middle">focal + diameter + location, BCE on domain</text>

  </g>
  <g data-lane="physics">
  <text class="s o" x="480" y="22">physics path</text>
  <path class="box draw-me" d={box(480, 30, 400, 48)} /><text class="s" x="680" y="50" text-anchor="middle">boundary interpolation</text><text class="s" x="680" y="67" text-anchor="middle">P₍bc₎ = P₍in₎(1−ξ) + P₍out₎ξ</text>
  <path class="draw-me o" d="M680 78 V98" />
  <path class="box draw-me" d={box(480, 98, 400, 48)} /><text class="s" x="680" y="118" text-anchor="middle">physics net</text><text class="s" x="680" y="135" text-anchor="middle">feat ⊕ ξ → 65 → 64×4 → 3</text>
  <path class="draw-me o" d="M680 146 V166" />
  <path class="box draw-me" d={box(480, 166, 400, 48)} /><text class="s" x="680" y="186" text-anchor="middle">field construction, leak source</text><text class="s" x="680" y="203" text-anchor="middle">ψ = ξ(1−ξ), autograd ∂/∂ξ</text>
  <path class="draw-me o" d="M680 214 V234" />
  <path class="box draw-me" d={box(480, 234, 400, 48)} /><text class="s" x="680" y="254" text-anchor="middle">PDE residuals, nondimensional</text><text class="s" x="680" y="271" text-anchor="middle">mass · momentum · mechanical energy</text>
  <path class="draw-me o" d="M680 282 V302" />
  <path class="box draw-me" d={box(480, 302, 400, 44)} /><text class="s" x="680" y="329" text-anchor="middle">residual loss, Σ ℛ²</text>

  </g>
  <path class="draw-me o" d="M220 334 V370 H450 V392" />
  <path class="draw-me o" d="M680 346 V370 H450" />
  <path class="box draw-me" d={box(320, 392, 260, 46)} /><text class="s" x="450" y="420" text-anchor="middle">composite objective</text>

  <path class="d" d="M20 466 H880" />
  <text class="s" x="20" y="459">stratified 5-fold cross-validation</text>
  <text class="n" x="20" y="504">{v('Leak detection F1')}</text><text class="s" x="20" y="522">detection F1</text>
  <text class="n" x="200" y="504">{v('Diameter R2')}</text><text class="s" x="200" y="522">diameter R²</text>
  <text class="n" x="380" y="504">{v('Location R2')}</text><text class="s" x="380" y="522">location R², 16.5% over the best classical baseline</text>
</svg>
