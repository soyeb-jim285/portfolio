---
// Follows Figure 4 of the paper: feature engineering, the shared trunk, its four task heads,
// the physics module down the right, and the composite loss they all feed.
import { research } from '../../data/content';
const box = (x: number, y: number, w: number, h: number) => `M${x} ${y}h${w}v${h}h${-w}z`;
const r = research.find((x) => x.slug === 'pce-pinn-pipelines')!.results;
const v = (label: string) => r.find((x) => x.label === label)?.value ?? '';

// The trunk is drawn as a real mesh rather than a labelled rectangle, so the fan-out to the
// heads reads as the shared representation it is.
const layers = [
  { x: 156, n: 4 },
  { x: 248, n: 5 },
  { x: 340, n: 5 },
  { x: 432, n: 4 },
];
const nodeY = (count: number, index: number) => 148 + (index - (count - 1) / 2) * 26;
const nodes = layers.map((layer) => Array.from({ length: layer.n }, (_, i) => ({ x: layer.x, y: nodeY(layer.n, i) })));
const edges = nodes.slice(0, -1).flatMap((column, i) => column.flatMap((a) => nodes[i + 1].map((b) => ({ a, b }))));
---
<svg class="diag draw r" viewBox="0 0 980 620" role="img" aria-label="PCE-PINN architecture: twelve raw inputs and fifteen engineered features are scaled and fed to a shared tanh trunk, which fans out to a leak head, a diameter head, a spatial attention location head and a gradient-reversal domain head; a physics module interpolates boundary conditions, predicts field corrections, builds the fields, adds a leak source and takes autograd derivatives to form nondimensional mass, momentum and energy residuals; data, domain and residual losses combine into the training objective">
  <text class="s o" x="20" y="22">feature engineering, 27 total</text>
  <path class="box draw-me" d={box(20, 32, 150, 44)} /><text class="s" x="95" y="52" text-anchor="middle">12 raw inputs</text><text class="s" x="95" y="68" text-anchor="middle">pressure, flow</text>
  <text x="183" y="60" text-anchor="middle">+</text>
  <path class="box draw-me" d={box(196, 32, 200, 44)} /><text class="s" x="296" y="52" text-anchor="middle">15 engineered</text><text class="s" x="296" y="68" text-anchor="middle">Re, Fr, We, x‌ᴸᴹ …</text>
  <path class="draw-me o" d="M396 54 H440" />
  <path class="box draw-me" d={box(440, 32, 130, 44)} /><text class="s" x="505" y="58" text-anchor="middle">robust scaler</text>
  <path class="draw-me o" d="M505 76 V92 H294" />

  <text class="s o" x="20" y="112">shared trunk, tanh</text>
  {edges.map((e) => <path class="mesh" d={`M${e.a.x} ${e.a.y}L${e.b.x} ${e.b.y}`} />)}
  {nodes.flat().map((n) => <circle class="node" cx={n.x} cy={n.y} r="7" />)}
  <text class="s" x="466" y="152">64-d</text>

  <path class="draw-me o" d="M432 200 V232 H95" />
  <path class="draw-me o" d="M294 200 V232" />
  <path class="draw-me o" d="M432 232 H600" />

  <text class="s o" x="20" y="250">4 task heads</text>
  <path class="box draw-me" d={box(20, 258, 148, 56)} /><text class="s" x="94" y="280" text-anchor="middle">leak head</text><text class="s" x="94" y="298" text-anchor="middle">64 → 24 → 1</text>
  <path class="box draw-me" d={box(180, 258, 148, 56)} /><text class="s" x="254" y="280" text-anchor="middle">diameter head</text><text class="s" x="254" y="298" text-anchor="middle">64 → 32 → 1</text>
  <path class="box draw-me" d={box(340, 258, 158, 56)} /><text class="s" x="419" y="280" text-anchor="middle">spatial attention</text><text class="s" x="419" y="298" text-anchor="middle">global + local, 3 zones</text>
  <path class="box draw-me" d={box(510, 258, 148, 56)} /><text class="s" x="584" y="280" text-anchor="middle">GRL domain</text><text class="s" x="584" y="298" text-anchor="middle">∇ → −λ∇</text>
  <text class="s" x="94" y="334" text-anchor="middle">leak probability</text>
  <text class="s" x="254" y="334" text-anchor="middle">diameter</text>
  <text class="s" x="419" y="334" text-anchor="middle">location</text>
  <text class="s" x="584" y="334" text-anchor="middle">domain label</text>

  <text class="s o" x="700" y="22">physics module</text>
  <path class="box draw-me" d={box(700, 32, 265, 46)} /><text class="s" x="832" y="52" text-anchor="middle">boundary interpolation</text><text class="s" x="832" y="68" text-anchor="middle">P₍bc₎ = P₍in₎(1−ξ) + P₍out₎ξ</text>
  <path class="draw-me o" d="M832 78 V92" />
  <path class="box draw-me" d={box(700, 92, 265, 46)} /><text class="s" x="832" y="112" text-anchor="middle">physics net</text><text class="s" x="832" y="128" text-anchor="middle">feat ⊕ ξ → 65 → 64×4 → 3</text>
  <path class="draw-me o" d="M832 138 V152" />
  <path class="box draw-me" d={box(700, 152, 265, 46)} /><text class="s" x="832" y="172" text-anchor="middle">field construction</text><text class="s" x="832" y="188" text-anchor="middle">ψ = ξ(1−ξ), P = P₍bc₎ + ψΔP</text>
  <path class="draw-me o" d="M770 198 V212" /><path class="draw-me o" d="M895 198 V212" />
  <path class="box draw-me" d={box(700, 212, 128, 42)} /><text class="s" x="764" y="238" text-anchor="middle">leak source</text>
  <path class="box draw-me" d={box(838, 212, 127, 42)} /><text class="s" x="901" y="238" text-anchor="middle">autograd ∂/∂ξ</text>
