---
import { research } from '../../data/content';
const box = (x: number, y: number, w: number, h: number) => `M${x} ${y}h${w}v${h}h${-w}z`;
const r = research.find((x) => x.slug === 'pinn-e2co-co2')!.results;
const v = (label: string) => r.find((x) => x.label === label)?.value ?? '';
---
<svg class="diag draw r" viewBox="0 0 700 356" role="img" aria-label="PINN-E2CO: pressure and saturation fields through a CNN encoder to a latent state advanced under well controls, decoded back to fields and read out by one MLP head per producer, trained against pressure diffusion, CO2 mass and Darcy flux residuals">
  <path class="box draw-me" d={box(10, 70, 105, 85)} />
  <text x="62" y="100" text-anchor="middle">fields</text><text class="s" x="62" y="120" text-anchor="middle">pressure</text><text class="s" x="62" y="137" text-anchor="middle">saturation</text>
  <path class="draw-me o" d="M115 112 H150" />

  <path class="box draw-me" d={box(150, 70, 110, 85)} /><text x="205" y="107" text-anchor="middle">CNN</text><text x="205" y="126" text-anchor="middle">encoder</text>
  <path class="draw-me o" d="M260 112 H295" />

  <path class="box draw-me" d={box(295, 70, 120, 85)} /><text x="355" y="100" text-anchor="middle">latent</text><text class="s" x="355" y="120" text-anchor="middle">locally linear</text><text class="s" x="355" y="137" text-anchor="middle">transition</text>
  <path class="box draw-me" d={box(295, 10, 120, 34)} /><text class="s" x="355" y="32" text-anchor="middle">well controls</text>
  <path class="draw-me o" d="M355 44 V70" />

  <path class="draw-me o" d="M415 92 H455" />
  <path class="draw-me o" d="M415 133 H455" />
  <path class="box draw-me" d={box(455, 70, 130, 45)} /><text class="s" x="520" y="89" text-anchor="middle">CNN decoder</text><text class="s" x="520" y="105" text-anchor="middle">fields back out</text>
  <path class="box draw-me" d={box(455, 123, 130, 45)} /><text class="s" x="520" y="142" text-anchor="middle">MLP head</text><text class="s" x="520" y="158" text-anchor="middle">one per producer</text>
  <path class="draw-me o" d="M585 145 H630" /><text class="s" x="635" y="149">well rates</text>

  <path class="box draw-me" d={box(120, 190, 490, 48)} />
  <text class="s" x="365" y="212" text-anchor="middle">PINN residuals: pressure diffusion, CO₂ mass, Darcy flux</text>
  <text class="s" x="365" y="229" text-anchor="middle">on the simulator's own finite-volume operator</text>
  <path class="d" d="M355 190 V155" />
  <path class="d" d="M520 190 V168" />

  <path class="d" d="M10 272 H690" />
  <text class="s" x="10" y="264">against the non-physics E2CO baseline, 12,000 realisations on a 64 × 64 grid</text>
  <text class="n" x="10" y="318">{v('Saturation RMSE')}</text><text class="s" x="10" y="338">saturation RMSE</text>
  <text class="n" x="170" y="318">{v('Pressure RMSE')}</text><text class="s" x="170" y="338">pressure RMSE</text>
  <text class="n" x="330" y="318">{v('Per-well R2')}</text><text class="s" x="330" y="338">filtered per-well R², after {v('Fine-tune time')} of fine-tuning on one T4</text>
</svg>
