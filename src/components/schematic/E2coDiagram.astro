---
// Figure 1 of the manuscript as two parallel paths — the surrogate down the left, the physics
// residuals down the right — meeting in the eight-term loss. Same structure, no crossing lines.
import { research } from '../../data/content';
const box = (x: number, y: number, w: number, h: number) => `M${x} ${y}h${w}v${h}h${-w}z`;
const r = research.find((x) => x.slug === 'pinn-e2co-co2')!.results;
const v = (label: string) => r.find((x) => x.label === label)?.value ?? '';
---
<svg class="diag draw r" viewBox="0 0 900 590" role="img" aria-label="PINN-E2CO: a surrogate path down the left from the reservoir state through a CNN encoder to a 20-dimensional latent, a locally linear transition under well controls, then a CNN decoder for the field and per-producer MLP heads for the well rates; a physics path down the right from the decoded field through time terms on a finite-volume stencil to the pressure-diffusion, CO2 mass and Darcy-flux residuals and their penalty; both meet in an eight-term composite loss">
  <g data-lane="surrogate">
  <text class="s o" x="20" y="22">E2CO surrogate</text>
  <path class="box draw-me" d={box(20, 30, 400, 48)} /><text class="s" x="220" y="50" text-anchor="middle">state x₍t₎ [B, 2, 64, 64] · controls u₍t₎, Δt</text><text class="s" x="220" y="67" text-anchor="middle">CO₂ mole fraction, pressure · 5 producers, 4 injectors</text>
  <path class="draw-me o" d="M220 78 V98" />
  <path class="box draw-me" d={box(20, 98, 400, 48)} /><text class="s" x="220" y="118" text-anchor="middle">CNN encoder</text><text class="s" x="220" y="135" text-anchor="middle">4 conv blocks + residual conv → z₍t₎ [B, 20]</text>
  <path class="draw-me o" d="M220 146 V166" />
  <path class="box draw-me" d={box(20, 166, 400, 48)} /><text class="s" x="220" y="186" text-anchor="middle">locally linear transition</text><text class="s" x="220" y="203" text-anchor="middle">z₍t+1₎ = A₍t₎z₍t₎ + B₍t₎(u₍t₎Δt)</text>

  <path class="draw-me o" d="M220 214 V234" />
  <path class="draw-me o" d="M115 234 H325" />
  <path class="draw-me o" d="M115 234 V254" /><path class="draw-me o" d="M325 234 V254" />
  <path class="box draw-me" d={box(20, 254, 190, 58)} /><text class="s" x="115" y="276" text-anchor="middle">CNN decoder</text><text class="s" x="115" y="294" text-anchor="middle">field [B, 2, 64, 64]</text>
  <path class="box draw-me" d={box(230, 254, 190, 58)} /><text class="s" x="325" y="276" text-anchor="middle">V19 observation heads</text><text class="s" x="325" y="294" text-anchor="middle">5 × MLP + injector → 14</text>

  <path class="draw-me o" d="M115 312 V334 H220" /><path class="draw-me o" d="M325 312 V334 H220" />
  <path class="draw-me o" d="M220 334 V356" />
  <path class="box draw-me" d={box(20, 356, 400, 48)} /><text class="s" x="220" y="376" text-anchor="middle">data objectives</text><text class="s" x="220" y="393" text-anchor="middle">reconstruction, transition consistency, well-rate MSE</text>

  </g>
  <g data-lane="physics">
  <text class="s o" x="480" y="22">PINN physics module</text>
  <path class="box draw-me" d={box(480, 30, 400, 48)} /><text class="s" x="680" y="50" text-anchor="middle">physics inputs</text><text class="s" x="680" y="67" text-anchor="middle">decoded x̂₍t+1₎, reference x₍t₎, K, φ, Δt</text>
  <path class="draw-me o" d="M680 78 V98" />
  <path class="box draw-me" d={box(480, 98, 400, 48)} /><text class="s" x="680" y="118" text-anchor="middle">time terms, finite-volume stencil</text><text class="s" x="680" y="135" text-anchor="middle">∂ₜp̂, ∂ₜĉ · harmonic transmissibility</text>
  <path class="draw-me o" d="M680 146 V166" />
  <path class="box draw-me" d={box(480, 166, 400, 66)} /><text class="s" x="680" y="188" text-anchor="middle">residuals on interior cells</text><text class="s" x="680" y="206" text-anchor="middle">pressure diffusion · CO₂ mass</text><text class="s" x="680" y="224" text-anchor="middle">Darcy flux</text>
  <path class="draw-me o" d="M680 232 V252" />
  <path class="box draw-me" d={box(480, 252, 400, 48)} /><text class="s" x="680" y="272" text-anchor="middle">residual penalty</text><text class="s" x="680" y="289" text-anchor="middle">weighted sum of the three residuals</text>

  </g>
  <path class="draw-me o" d="M220 404 V430 H450 V452" />
  <path class="draw-me o" d="M680 300 V430 H450" />
  <path class="box draw-me" d={box(300, 452, 300, 48)} /><text class="s" x="450" y="472" text-anchor="middle">eight-term composite loss</text><text class="s" x="450" y="489" text-anchor="middle">ℒ = Σ λᵢ ℒᵢ, K = 2 rollout</text>

  <path class="d" d="M20 524 H880" />
  <text class="s" x="20" y="517">against the non-physics E2CO baseline, 12,000 realisations on a 64 × 64 grid</text>
  <text class="n" x="20" y="558">{v('Saturation RMSE')}</text><text class="s" x="20" y="578">saturation RMSE</text>
  <text class="n" x="200" y="558">{v('Pressure RMSE')}</text><text class="s" x="200" y="578">pressure RMSE</text>
  <text class="n" x="380" y="558">{v('Per-well R2')}</text><text class="s" x="380" y="578">per-well R², after {v('Fine-tune time')} on one T4</text>
</svg>
