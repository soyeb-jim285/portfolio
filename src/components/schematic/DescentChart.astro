---
// The whole story in one figure: launch to a mapped window, home directory, after each group of
// work. Drawn as a line because the x axis is time; points sit at the centre of each label column.
const points = [
  { ms: 336, when: '30 Aug', what: ['baseline'] },
  { ms: 194, when: '19 Sep', what: ['renderer, lazy UI,', 'lighter models'] },
  { ms: 180, when: '20 Sep', what: ['full benchmark', 'as reference'] },
  { ms: 170, when: '20 Sep', what: ['collation keys,', 'readdir, warm Vulkan'] },
  { ms: 163, when: '20 Sep', what: ['font stack', 'on a worker'] },
];
const max = 360;
const x = (i: number) => ((i + 0.5) / points.length) * 100;
const y = (ms: number) => 100 - (ms / max) * 100;
const line = points.map((p, i) => `${x(i).toFixed(2)},${y(p.ms).toFixed(2)}`).join(' ');
---
<figure class="chart">
  <div class="chart-head">
    <b>336 down to 163</b>
    <span>Launch to a mapped window, home directory, one AMD laptop under Hyprland.</span>
  </div>
  <div class="line-chart" role="img" aria-label="Startup time falling from 336 ms on 30 August to 163 ms on 20 September, in five steps. The same figures are in the table below.">
    <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><polyline points={line} vector-effect="non-scaling-stroke" /></svg>
    {points.map((p, i) => <span class="line-point" style={`left:${x(i)}%;top:${y(p.ms)}%`}><b>{p.ms} ms</b></span>)}
  </div>
  <ol class="line-x" aria-hidden="true">
    {points.map((p) => <li>{p.when}<small>{p.what.join(' ')}</small></li>)}
  </ol>
  <figcaption>
    <p><b>FIG. 1</b>Lower is better. Each point is the median of at least seven runs, round robin against the other builds, one discarded warm-up each.</p>
  </figcaption>
  <details class="tview">
    <summary>The numbers behind this chart</summary>
    <div class="tw">
      <table>
        <thead><tr><th>Date</th><th>What landed</th><th class="nw">map, home (ms)</th></tr></thead>
        <tbody>
          {points.map((p) => <tr><td class="nw">{p.when} 2026</td><td class="m">{p.what.join(' ')}</td><td class="q">{p.ms}</td></tr>)}
        </tbody>
      </table>
    </div>
  </details>
</figure>
