---
import { research } from '../../data/content';
const box = (x: number, y: number, w: number, h: number) => `M${x} ${y}h${w}v${h}h${-w}z`;
const r = research.find((x) => x.slug === 'mumidc-abc2026')!.results;
const v = (label: string) => r.find((x) => x.label === label)?.value ?? '';
---
<svg class="diag draw r" viewBox="0 0 680 310" role="img" aria-label="MUMIDC pipeline: EEG, EMG and IMU into a CNN2D, then a TCN, late fusion with statistical EEG features, seven motor task classes at 87.5 percent accuracy">
  <path class="box draw-me" d={box(10, 20, 90, 50)} /><text x="55" y="50" text-anchor="middle">EEG</text>
  <path class="box draw-me" d={box(10, 95, 90, 50)} /><text x="55" y="125" text-anchor="middle">EMG</text>
  <path class="box draw-me" d={box(10, 170, 90, 50)} /><text x="55" y="200" text-anchor="middle">IMU</text>
  <path class="draw-me o" d="M100 45 H140 V120 H180" />
  <path class="draw-me o" d="M100 120 H180" />
  <path class="draw-me o" d="M100 195 H140 V120" />
  <path class="box draw-me" d={box(180, 80, 120, 80)} /><text x="240" y="115" text-anchor="middle">CNN2D</text><text class="s" x="240" y="135" text-anchor="middle">per-window maps</text>
  <path class="draw-me o" d="M300 120 H340" />
  <path class="box draw-me" d={box(340, 80, 120, 80)} /><text x="400" y="115" text-anchor="middle">TCN</text><text class="s" x="400" y="135" text-anchor="middle">temporal conv</text>
  <path class="d" d="M55 70 V82 H125 V235 H330" />
  <path class="box draw-me" d={box(330, 210, 160, 50)} /><text x="410" y="232" text-anchor="middle">EEG statistics</text><text class="s" x="410" y="249" text-anchor="middle">hand-picked features</text>
  <path class="draw-me o" d="M460 120 H520" />
  <path class="draw-me o" d="M490 235 H500 V150 H520" />
  <path class="box draw-me" d={box(520, 80, 140, 90)} /><text x="590" y="115" text-anchor="middle">late fusion</text><text class="s" x="590" y="135" text-anchor="middle">deep + statistical</text>
  <path class="draw-me o" d="M590 170 V210" />
  <path class="box draw-me" d={box(520, 210, 140, 50)} /><text x="590" y="240" text-anchor="middle">7 motor tasks</text>
  <text class="n" x="10" y="290">{v('Accuracy')}</text><text class="s" x="120" y="290">accuracy</text>
  <text class="n" x="200" y="290">{v('Macro AUC')}</text><text class="s" x="300" y="290">macro AUC, mixed LOSO, 16 subjects</text>
</svg>
