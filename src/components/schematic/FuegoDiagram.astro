---
// What Apa does, at the level Fuego's own marketing describes it. Fuego's engineering is confidential,
// so nothing here shows how it is built. Boxes are paths so getTotalLength() drives the draw-in, and
// every block carries the key of the spec row that describes it, so a hover on either lights the other.
const box = (x: number, y: number, w: number, h: number) => `M${x} ${y}h${w}v${h}h${-w}z`;
---
<svg class="diag draw r" viewBox="0 0 745 320" role="img" aria-label="Block diagram of Apa: a shopper sends text, an image or a voice note to the agent, which calls commerce tools and product search and streams back product cards. Brand configuration and production controls support it.">
  <g data-blk="multimodal">
    <path class="box draw-me" d={box(10, 92, 124, 76)} /><text x="72" y="122" text-anchor="middle">shopper</text><text class="s" x="72" y="141" text-anchor="middle">native app</text><text class="s" x="72" y="157" text-anchor="middle">text, image, voice</text>
  </g>
  <path class="draw-me o" d="M134 130 H165" />
  <g data-blk="platform">
    <path class="box draw-me" d={box(165, 82, 120, 96)} /><text class="n" x="225" y="120" text-anchor="middle">Apa</text><text class="s" x="225" y="145" text-anchor="middle">shopping agent</text><text class="s" x="225" y="163" text-anchor="middle">streamed chat</text>
  </g>
  <path class="draw-me o" d="M285 112 H310 V72 H335" />
  <path class="draw-me o" d="M285 148 H310 V182 H335" />
  <g data-blk="tools">
    <path class="box draw-me" d={box(335, 35, 150, 74)} /><text x="410" y="65" text-anchor="middle">commerce tools</text><text class="s" x="410" y="82" text-anchor="middle">products, reviews,</text><text class="s" x="410" y="98" text-anchor="middle">orders</text>
  </g>
  <g data-blk="retrieval">
    <path class="box draw-me" d={box(335, 145, 150, 74)} /><text x="410" y="175" text-anchor="middle">product search</text><text class="s" x="410" y="197" text-anchor="middle">semantic, live catalog</text>
  </g>
  <path class="draw-me o" d="M485 72 H510 V112 H535" />
  <path class="draw-me o" d="M485 182 H510 V148 H535" />
  <g data-blk="multimodal">
    <path class="box draw-me" d={box(535, 90, 150, 80)} /><text x="610" y="122" text-anchor="middle">streamed results</text><text class="s" x="610" y="145" text-anchor="middle">product cards</text>
  </g>
  <g data-blk="platform">
    <path class="box draw-me" d={box(155, 240, 140, 62)} /><text x="225" y="266" text-anchor="middle">brand config</text><text class="s" x="225" y="287" text-anchor="middle">per-brand setup</text>
  </g>
  <g data-blk="reliability">
    <path class="box draw-me" d={box(330, 240, 160, 62)} /><text x="410" y="264" text-anchor="middle">production</text><text x="410" y="280" text-anchor="middle">controls</text><text class="s" x="410" y="297" text-anchor="middle">cache, rate limits</text>
  </g>
  <path class="d" d="M225 240 V178" />
  <path class="d" d="M410 240 V229 H265 V178" />
</svg>
