---
// Public architecture summary of Apa. Boxes are paths so getTotalLength() drives the draw-in.
const box = (x: number, y: number, w: number, h: number) => `M${x} ${y}h${w}v${h}h${-w}z`;
---
<svg class="diag draw r" viewBox="0 0 745 320" role="img" aria-label="Block diagram of Apa: a shopper uses the agent, which runs a structured tool loop over hybrid retrieval and commerce tools before streaming rich results; brand configuration and production controls support the pipeline">
  <g data-blk="shopper">
    <path class="box draw-me" d={box(10, 100, 80, 60)} /><text x="50" y="128" text-anchor="middle">shopper</text><text class="s" x="50" y="147" text-anchor="middle">native app</text>
  </g>
  <path class="draw-me o" d="M90 130 H125" />
  <g data-blk="platform">
    <path class="box draw-me" d={box(125, 82, 110, 96)} /><text class="n" x="180" y="120" text-anchor="middle">Apa</text><text class="s" x="180" y="145" text-anchor="middle">shopping agent</text><text class="s" x="180" y="163" text-anchor="middle">persistent chat</text>
  </g>
  <path class="draw-me o" d="M235 130 H270" />
  <g data-blk="tools">
    <path class="box draw-me" d={box(270, 82, 120, 96)} /><text x="330" y="118" text-anchor="middle">tool loop</text><text class="s" x="330" y="142" text-anchor="middle">structured calls</text><text class="s" x="330" y="160" text-anchor="middle">bounded steps</text>
  </g>
  <path class="draw-me o" d="M390 112 H410 V72 H430" />
  <path class="draw-me o" d="M390 148 H410 V182 H430" />
  <g data-blk="retrieval">
    <path class="box draw-me" d={box(430, 35, 140, 74)} /><text x="500" y="65" text-anchor="middle">hybrid retrieval</text><text class="s" x="500" y="87" text-anchor="middle">vectors + live data</text>
  </g>
  <g data-blk="tools">
    <path class="box draw-me" d={box(430, 145, 140, 74)} /><text x="500" y="175" text-anchor="middle">commerce tools</text><text class="s" x="500" y="192" text-anchor="middle">products, reviews,</text><text class="s" x="500" y="208" text-anchor="middle">orders</text>
  </g>
  <path class="draw-me o" d="M570 72 H585 V112 H600" />
  <path class="draw-me o" d="M570 182 H585 V148 H600" />
  <g data-blk="multimodal">
    <path class="box draw-me" d={box(600, 90, 140, 80)} /><text x="670" y="122" text-anchor="middle">streamed results</text><text class="s" x="670" y="145" text-anchor="middle">cards, image, voice</text>
  </g>
  <g data-blk="platform">
    <path class="box draw-me" d={box(110, 240, 140, 62)} /><text x="180" y="264" text-anchor="middle">brand config</text><text class="s" x="180" y="283" text-anchor="middle">context + tools</text><text class="s" x="180" y="297" text-anchor="middle">models + styling</text>
  </g>
  <g data-blk="reliability">
    <path class="box draw-me" d={box(260, 240, 140, 62)} /><text x="330" y="264" text-anchor="middle">production</text><text x="330" y="280" text-anchor="middle">controls</text><text class="s" x="330" y="297" text-anchor="middle">cache + recovery</text>
  </g>
  <path class="d" d="M180 240 V178" />
  <path class="d" d="M330 240 V178" />
</svg>
