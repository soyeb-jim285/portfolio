---
// Public architecture summary of Apa, drawn from the request path in the chat controller. Boxes are
// paths so getTotalLength() drives the draw-in. Every block carries the key of the spec row that
// describes it, so a hover on either side lights the other.
import { work } from '../../data/content';
const box = (x: number, y: number, w: number, h: number) => `M${x} ${y}h${w}v${h}h${-w}z`;
const cached = work.scale.find((s) => s.label.includes('cache'))!.value;
---
<svg class="diag draw r" viewBox="0 0 946 320" role="img" aria-label={`Block diagram of Apa. A shopper sends text, an image or a voice note to the agent. The answer cache is checked first: a hit, ${cached} of messages, streams straight back without calling the model. A miss runs a bounded tool loop over commerce tools and hybrid retrieval, whose results stream back as cards. Brand configuration, production controls and a scheduled index refresh support the path.`}>
  <g data-blk="multimodal">
    <path class="box draw-me" d={box(10, 92, 124, 76)} /><text x="72" y="122" text-anchor="middle">shopper</text><text class="s" x="72" y="141" text-anchor="middle">native app</text><text class="s" x="72" y="157" text-anchor="middle">text, image, voice</text>
  </g>
  <path class="draw-me o" d="M134 130 H160" />
  <g data-blk="platform">
    <path class="box draw-me" d={box(160, 82, 110, 96)} /><text class="n" x="215" y="120" text-anchor="middle">Apa</text><text class="s" x="215" y="145" text-anchor="middle">shopping agent</text><text class="s" x="215" y="163" text-anchor="middle">persistent chat</text>
  </g>
  <path class="draw-me o" d="M270 130 H296" />
  <g data-blk="reliability">
    <path class="box draw-me" d={box(296, 82, 120, 96)} /><text x="356" y="118" text-anchor="middle">answer cache</text><text class="s" x="356" y="142" text-anchor="middle">shared generation</text><text class="s" x="356" y="160" text-anchor="middle">drift recheck</text>
  </g>
  <!-- a hit never reaches the model: it streams the stored answer and rechecks it in the background -->
  <path class="draw-me o" d="M356 82 V20 H866 V90" />
  <text class="s o" x="611" y="13" text-anchor="middle">hit, {cached} of messages: no model call</text>
  <path class="draw-me o" d="M416 130 H466" />
  <text class="s" x="441" y="122" text-anchor="middle">miss</text>
  <g data-blk="tools">
    <path class="box draw-me" d={box(466, 82, 120, 96)} /><text x="526" y="118" text-anchor="middle">tool loop</text><text class="s" x="526" y="142" text-anchor="middle">structured calls</text><text class="s" x="526" y="160" text-anchor="middle">bounded steps</text>
  </g>
  <path class="draw-me o" d="M586 112 H606 V72 H626" />
  <path class="draw-me o" d="M586 148 H606 V182 H626" />
  <g data-blk="tools">
    <path class="box draw-me" d={box(626, 35, 140, 74)} /><text x="696" y="65" text-anchor="middle">commerce tools</text><text class="s" x="696" y="82" text-anchor="middle">products, reviews,</text><text class="s" x="696" y="98" text-anchor="middle">orders, actions</text>
  </g>
  <g data-blk="retrieval">
    <path class="box draw-me" d={box(626, 145, 140, 74)} /><text x="696" y="175" text-anchor="middle">hybrid retrieval</text><text class="s" x="696" y="197" text-anchor="middle">vectors + live data</text>
  </g>
  <path class="draw-me o" d="M766 72 H781 V112 H796" />
  <path class="draw-me o" d="M766 182 H781 V148 H796" />
  <g data-blk="multimodal">
    <path class="box draw-me" d={box(796, 90, 140, 80)} /><text x="866" y="122" text-anchor="middle">streamed results</text><text class="s" x="866" y="145" text-anchor="middle">cards + try-on image</text>
  </g>
  <g data-blk="platform">
    <path class="box draw-me" d={box(145, 240, 140, 62)} /><text x="215" y="264" text-anchor="middle">brand config</text><text class="s" x="215" y="283" text-anchor="middle">context + tools</text><text class="s" x="215" y="297" text-anchor="middle">models + styling</text>
  </g>
  <g data-blk="reliability">
    <path class="box draw-me" d={box(456, 240, 140, 62)} /><text x="526" y="264" text-anchor="middle">production</text><text x="526" y="280" text-anchor="middle">controls</text><text class="s" x="526" y="297" text-anchor="middle">limits + metering</text>
  </g>
  <g data-blk="reliability">
    <path class="box draw-me" d={box(626, 240, 140, 62)} /><text x="696" y="264" text-anchor="middle">index refresh</text><text class="s" x="696" y="283" text-anchor="middle">scheduled re-embed</text><text class="s" x="696" y="297" text-anchor="middle">content-hash diff</text>
  </g>
  <path class="d" d="M215 240 V178" />
  <path class="d" d="M526 240 V178" />
  <path class="d" d="M696 240 V219" />
</svg>
