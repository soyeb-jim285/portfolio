---
// Values come from the build; src/scripts/github-stats.ts refreshes them in the browser.
const { repo, stars, forks, contributors } = Astro.props; // repo is "owner/name"
---
<li>
  <span>GitHub stars</span><span class="gh-value" data-gh-repo={repo} data-gh-field="stars" aria-live="polite">{stars}</span>
</li>
<li>
  <span>Forks</span><span class="gh-value" data-gh-repo={repo} data-gh-field="forks" aria-live="polite">{forks}</span>
</li>
<li>
  <span>Contributors</span><span aria-live="polite"><span class="gh-value" data-gh-repo={repo} data-gh-field="contributors">{contributors}</span>, <span data-gh-repo={repo} data-gh-field="outside">{contributors - 1}</span> from outside</span>
</li>
