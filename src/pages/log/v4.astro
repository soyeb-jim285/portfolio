---
// Variant 4, "Console": every block labelled in a left gutter, measurements given the room.
// Movement: the readouts count up on arrival, and each panel is uncovered by a printing sweep.
import '@fontsource/ibm-plex-serif/400.css';
import '@fontsource/ibm-plex-serif/400-italic.css';
import '@fontsource/ibm-plex-serif/600.css';
import '../../styles/log-shared.css';
import '../../styles/log-v4.css';
import Layout from '../../layouts/SchematicLayout.astro';
import VariantSwitch from '../../components/log/VariantSwitch.astro';
import { figures, post, sections } from '../../data/log/startup-halved';
import { palette } from '../../lib/log-palette';

const fmt = (v: number) => (Number.isInteger(v) ? String(v) : v.toFixed(v < 10 ? 2 : 1));
const swatch = (id: keyof typeof figures, i: number) => {
  const figure = figures[id];
  if (figure.stacked) return palette.stack[i];
  return i === 0 && figure.series.length > 1 ? palette.dim : palette.accent;
};
const panelHeight = (id: keyof typeof figures) => {
  const figure = figures[id];
  if (figure.kind === 'line') return 300;
  return Math.max(170, figure.rows.length * (figure.series.length > 1 && !figure.stacked ? 46 : 34) + 60);
};
const tagFor = (t: string) => ({ p: 'text', h: 'subject', list: 'checklist', note: 'logged', table: 'readout', stats: 'summary', quote: 'remark', fig: 'instrument' })[t] ?? '';
---
<Layout
  title={`${post.title}, layout 4, Soyeb Pervez Jim`}
  description={post.dek}
  sheet="9.4"
  big="Log V4"
  stamp={{ k: 'Layout', v: 'Console' }}
>
  <VariantSwitch v={4} />

  <article class="vpost vconsole" data-anchor="log-post">
    <div class="blk">
      <span class="tag">Entry</span>
      <div class="body">
        <h1 class="title">{post.title}</h1>
        <p class="sub">{post.dek}</p>
        <p class="vby">
          <span>Sheet <b>9.4</b></span>
          <span>Written <b>{post.when}</b></span>
          <span>About <b>{post.subject}</b></span>
          <span>Reading <b>{post.minutes} min</b></span>
        </p>
      </div>
    </div>

    {sections.map((section) => (
      <>
        {section.title && (
          <div class="blk sec" id={section.id}>
            <span class="tag">Sec {section.n}</span>
            <div class="body">
              <h2 class="t2">{section.title}</h2>
              {section.sub && <p class="sub">{section.sub}</p>}
            </div>
          </div>
        )}
        {section.blocks.map((block) => (
          <div class:list={['blk', (block.t === 'fig' || block.t === 'stats' || block.t === 'table') && 'wide']}>
            <span class="tag">{tagFor(block.t)}</span>
            <div class="body">
              {block.t === 'p' && <p class={block.lede ? 'lede' : 'copy'} set:html={block.text} />}
              {block.t === 'h' && <h3>{block.text}</h3>}
              {block.t === 'list' && <ul>{block.items.map((item) => <li set:html={item} />)}</ul>}
              {block.t === 'quote' && <p class="vquote">{block.text}</p>}
              {block.t === 'note' && (
                <aside class="vnote">
                  <span>{block.title}</span>
                  {block.paras.map((para) => <p set:html={para} />)}
                </aside>
              )}
              {block.t === 'stats' && (
                <div class="vstats">{block.items.map((item) => <div><strong data-count>{item.value}</strong><span>{item.label}</span></div>)}</div>
              )}
              {block.t === 'table' && (
                <div class="tw">
                  <table>
                    <thead><tr>{block.head.map((cell) => <th>{cell}</th>)}</tr></thead>
                    <tbody>{block.rows.map((row) => <tr>{row.map((cell, i) => <td class={i === row.length - 1 ? 'q' : 'm'} set:html={cell} />)}</tr>)}</tbody>
                  </table>
                </div>
              )}
              {block.t === 'fig' && (
                <figure class="vfig">
                  <div class="vfig-head">
                    <span class="no">{figures[block.id].fig}</span>
                    <b>{figures[block.id].title}</b>
                    <span class="unit">{figures[block.id].unit}</span>
                  </div>
                  <p class="vfig-note">{figures[block.id].note}</p>
                  {figures[block.id].series.length > 1 && (
                    <p class="vkey">{figures[block.id].series.map((name, i) => <span><i style={`background:${swatch(block.id, i)}`}></i>{name}</span>)}</p>
                  )}
                  <div class="chartbox" style={`--h:${panelHeight(block.id)}px`} data-figure={JSON.stringify(figures[block.id])} role="img" aria-label={`${figures[block.id].title}. ${figures[block.id].note} The same figures are in the table below.`}></div>
                  <figcaption>
                    <p><b>{figures[block.id].fig}</b>{figures[block.id].caption}</p>
                    <details class="vtable">
                      <summary>Raw values</summary>
                      <div class="tw">
                        <table>
                          <thead><tr><th></th>{figures[block.id].series.map((name) => <th class="nw">{name} ({figures[block.id].unit})</th>)}</tr></thead>
                          <tbody>
                            {figures[block.id].rows.map((row) => (
                              <tr>
                                <td>{row.label}{row.tag && `, ${row.tag}`}</td>
                                {row.values.map((v) => <td>{v == null ? '—' : fmt(v)}</td>)}
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    </details>
                  </figcaption>
                </figure>
              )}
            </div>
          </div>
        ))}
      </>
    ))}

    <p class="cap">Layout 4 of 5. Figures are ECharts canvases; the library is imported when the first panel comes into view, not on load.</p>

    <nav class="pn" aria-label="Previous and next sheet">
      <a href="/log/v3/"><small>Previous layout</small><b>V3 Index</b></a>
      <a href="/log/v5/"><small>Next layout</small><b>V5 Pinned</b></a>
    </nav>
  </article>

  <script>
    import { initPanels } from '../../scripts/echart-figures';
    import { countUp, reveal } from '../../scripts/log-reveal';
    const start = () => { void initPanels(); reveal('.vconsole .vfig', { threshold: 0.12 }); countUp('.vconsole [data-count]'); };
    start();
    document.addEventListener('astro:page-load', start);
  </script>
</Layout>
