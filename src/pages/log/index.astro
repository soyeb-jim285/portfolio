---
import '@fontsource/ibm-plex-serif/400.css';
import Layout from '../../layouts/SchematicLayout.astro';
import { posts } from '../../data/posts';
---
<Layout
  title="Log, Soyeb Pervez Jim"
  description="Notes on work that had to be measured: profiling, optimisation and the measurements that turned out to be wrong."
  sheet="9"
  big="Log"
  stamp={{ k: 'Entries', v: `${posts.length}` }}
>
  <section class="head" data-anchor="log-list">
    <h1 class="title">Log</h1>
    <p class="sub">Write-ups of work where the only honest evidence is a number. Each entry keeps the measurements that justified a change, and the ones that sent me the wrong way for an afternoon.</p>
  </section>

  <div class="posts">
    {posts.map((post, i) => (
      <a href={`/log/${post.slug}/`}>
        <span class="when">{post.when}<span class="small">Sheet 9.{i + 1}</span></span>
        <span>
          <b>{post.title}</b>
          <span class="dek">{post.dek}</span>
        </span>
        <span class="len">{post.minutes} min</span>
      </a>
    ))}
  </div>

  <p class="sub">The long-hand version of the first entry lives in the repository as <code>docs/performance-history.md</code>, with every commit hash. This sheet is the readable cut.</p>
</Layout>
