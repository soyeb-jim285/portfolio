---
// Variant 2, "Column": one centred measure under a large drawing number, figures across the full
// sheet. Movement: blocks lift into place as they arrive, and a figure is uncovered left to right.
import '@fontsource/ibm-plex-serif/400.css';
import '@fontsource/ibm-plex-serif/400-italic.css';
import '@fontsource/ibm-plex-serif/600.css';
import '../../styles/log-shared.css';
import '../../styles/log-v2.css';
import Layout from '../../layouts/SchematicLayout.astro';
import VariantSwitch from '../../components/log/VariantSwitch.astro';
import { figures, post, sections } from '../../data/log/startup-halved';
import { renderFigure } from '../../lib/plot-ssr';
import { palette } from '../../lib/log-palette';

const drawn = Object.fromEntries(Object.entries(figures).map(([id, figure]) => [id, renderFigure(figure, 860)]));
const swatch = (id: keyof typeof figures, i: number) => {
  const figure = figures[id];
  if (figure.stacked) return palette.stack[i];
  return i === 0 && figure.series.length > 1 ? palette.dim : palette.accent;
};
const fmt = (v: number) => (Number.isInteger(v) ? String(v) : v.toFixed(v < 10 ? 2 : 1));
---
<Layout
  title={`${post.title}, layout 2, Soyeb Pervez Jim`}
  description={post.dek}
  sheet="9.2"
  big="Log V2"
  stamp={{ k: 'Layout', v: 'Column' }}
>
  <VariantSwitch v={2} />

  <article class="vpost vcol" data-anchor="log-post">
    <section class="head" data-rise>
      <h1 class="title">{post.title}</h1>
      <p class="sub">{post.dek}</p>
      <p class="vby">
        <span>Sheet <b>9.2</b></span>
        <span>Written <b>{post.when}</b></span>
        <span>About <b>{post.subject}</b></span>
        <span>Reading <b>{post.minutes} min</b></span>
      </p>
    </section>

    {sections.map((section) => (
      <>
        {section.title && (
          <section class="sec" id={section.id} data-rise>
            <span class="num">{section.n}</span>
            <h2 class="t2">{section.title}</h2>
            {section.sub && <p class="sub">{section.sub}</p>}
          </section>
        )}
        {section.blocks.map((block) => {
          if (block.t === 'p') return <div class="band" data-rise><p class={block.lede ? 'lede' : 'copy'} set:html={block.text} /></div>;
          if (block.t === 'h') return <div class="band" data-rise><h3>{block.text}</h3></div>;
          if (block.t === 'list') return <div class="band" data-rise><ul>{block.items.map((item) => <li set:html={item} />)}</ul></div>;
          if (block.t === 'quote') return <p class="vquote" data-rise>{block.text}</p>;
          if (block.t === 'note') return (
            <div class="band" data-rise>
              <aside class="vnote">
                <span>{block.title}</span>
                {block.paras.map((para) => <p set:html={para} />)}
              </aside>
            </div>
          );
          if (block.t === 'stats') return (
            <div class="vstats" data-rise>{block.items.map((item) => <div><strong>{item.value}</strong><span>{item.label}</span></div>)}</div>
          );
          if (block.t === 'table') return (
            <div class="tw" data-rise>
              <table>
                <thead><tr>{block.head.map((cell) => <th>{cell}</th>)}</tr></thead>
                <tbody>{block.rows.map((row) => <tr>{row.map((cell, i) => <td class={i === row.length - 1 ? 'q' : 'm'} set:html={cell} />)}</tr>)}</tbody>
              </table>
            </div>
          );
          const figure = figures[block.id];
          return (
            <figure class="vfig" data-rise>
              <div class="vfig-head">
                <span class="no">{figure.fig}</span>
                <b>{figure.title}</b>
                <span class="unit">{figure.unit}</span>
              </div>
              <p class="vfig-note">{figure.note}</p>
              {figure.series.length > 1 && (
                <p class="vkey">{figure.series.map((name, i) => <span><i style={`background:${swatch(block.id, i)}`}></i>{name}</span>)}</p>
              )}
              <div class="figbody" set:html={drawn[block.id]} />
              <figcaption>
                <p><b>{figure.fig}</b>{figure.caption}</p>
                <details class="vtable">
                  <summary>The numbers behind this figure</summary>
                  <div class="tw">
                    <table>
                      <thead><tr><th></th>{figure.series.map((name) => <th class="nw">{name} ({figure.unit})</th>)}</tr></thead>
                      <tbody>
                        {figure.rows.map((row) => (
                          <tr>
                            <td>{row.label}{row.tag && `, ${row.tag}`}</td>
                            {row.values.map((v) => <td>{v == null ? '—' : fmt(v)}</td>)}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </details>
              </figcaption>
            </figure>
          );
        })}
      </>
    ))}

    <p class="cap" data-rise>Layout 2 of 5. Figures drawn with Observable Plot during the build and served as inline SVG; the browser downloads no charting library.</p>

    <nav class="pn" aria-label="Previous and next sheet">
      <a href="/log/v1/"><small>Previous layout</small><b>V1 Rail</b></a>
      <a href="/log/v3/"><small>Next layout</small><b>V3 Index</b></a>
    </nav>
  </article>

  <script>
    import { reveal } from '../../scripts/log-reveal';
    const start = () => { reveal('.vcol [data-rise]', { stagger: true, threshold: 0.1 }); reveal('.vcol .vfig', { threshold: 0.1 }); };
    start();
    document.addEventListener('astro:page-load', start);
  </script>
</Layout>
