---
import Layout from '../../layouts/SchematicLayout.astro';
import GitHubStats from '../../components/GitHubStats.astro';
import { projects } from '../../data/content';
import { projectQuestion } from '../../data/assistant-questions';
import { Globe } from 'lucide-react';
export function getStaticPaths() {
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { p, i } }));
}
const { p, i } = Astro.props;
const n = projects.length;
const prev = projects[(i - 1 + n) % n];
const next = projects[(i + 1) % n];
const gallery = p.images?.filter((x) => x !== p.image) ?? [];
// Slugs match the GitHub repository name for the projects whose source is indexed.
const live = p.links.find((l) => l.label === 'Live')?.href;
// Repo and running-site links go in the header so they are seen first; the full list stays in the specs.
const isGh = (l: { href: string }) => l.href.startsWith('https://github.com/');
const top = p.links.filter((l) => l.label === 'Live' || l.label === 'Site' || isGh(l)).sort((a, b) => Number(isGh(a)) - Number(isGh(b)));
const alts: Record<string, string> = {
  '/assets/ielts-pace.webp': 'Speaking pace in 10-second windows against the band-7 range, with every pause',
  '/assets/ielts-writing-fixes.webp': 'Writing: the three fixes that matter most, each with a before and after',
  '/assets/nnxray-feature-maps.webp': 'All 64 pooled channels of the third convolution',
  '/assets/nnxray-verdict.webp': 'Softmax verdict with the runner-up classes',
};
// Every figure on a sheet shares one aspect ratio, so the width and height attributes reserve the right box.
const [w, h] = p.size ?? [1600, 1000];
// HyprFM's tour and clips already show the window, so its screenshot is only the list thumbnail.
const lead = p.slug !== 'hyprfm';
---
<Layout title={`${p.name}, Soyeb Pervez Jim`} description={`${p.name}: ${p.kicker}. ${p.summary}`} sheet={`5.${i + 1}`} big={p.name} stamp={p.stars ? { k: 'Stars', v: String(p.stars), gh: p.repo } : { k: 'Type', v: 'Open source' }}>
  <section class="head r" data-anchor="project-detail">
    <h1 class="title">{p.name}</h1>
    <p class="sub">{p.kicker}. {p.summary}</p>
    <p class="btns">
      {top.map((l, k) => (
        <a class={`btn${k === 0 ? ' fill' : ''}`} href={l.href} target="_blank" rel="noopener">
          {isGh(l)
            ? <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" /></svg>
            : <Globe size={18} aria-hidden="true" />}
          {isGh(l) && l.label !== 'GitHub' ? `GitHub: ${l.label}` : l.label}
        </a>
      ))}
      <button type="button" class="btn" data-assistant-ask={projectQuestion(p.name)}>Ask about {p.name}</button>
    </p>
  </section>

  {p.videos && (
    <div class="details r" style={p.videos.length > 1 ? undefined : 'grid-template-columns:1fr'}>
      {p.videos.map((v, k, all) => (
        <figure>
          <video controls playsinline preload="none" poster={v.poster} width="1600" height="900" src={v.src} aria-label={v.caption}></video>
          <figcaption><b>FIG. 0{all.length > 1 ? String.fromCharCode(65 + k) : ''}</b>{v.caption}</figcaption>
        </figure>
      ))}
    </div>
  )}

  {p.image ? (
    <section>
      {lead && (
        <figure class="details r" style="grid-template-columns:1fr;margin:0">
          <div>
            <img src={p.image} alt={`${p.name} screenshot`} width={w} height={h} />
            <figcaption><b>FIG. 1</b>{p.name}{live && `, live at ${new URL(live).host}`}</figcaption>
          </div>
        </figure>
      )}
      {(p.clips || gallery.length > 0) && <div class="details r" style={lead ? 'margin-top:32px' : undefined}>
        {p.clips?.map((c, k) => (
          <figure>
            <video autoplay muted loop playsinline poster={c.poster} src={c.src} width="1600" height="1000" aria-label={c.alt}></video>
            <figcaption><b>CLIP {k + 1}</b>{c.alt}</figcaption>
          </figure>
        ))}
        {gallery.map((src, k) => (
          <figure>
            <img src={src} alt={alts[src] ?? `${p.name} screenshot`} loading="lazy" width={w} height={h} />
            <figcaption><b>DETAIL {String.fromCharCode(65 + k)}</b>{alts[src]}</figcaption>
          </figure>
        ))}
      </div>}
    </section>
  ) : (
    <div class="nofig r"><span>No figure on this sheet</span><span class="cap">See the repository</span></div>
  )}

  <section class="split r">
    <div>
      <ul class="specs tight">
        {p.repo && <GitHubStats repo={p.repo} stars={p.stars} forks={p.forks} contributors={p.contributors} />}
        {p.facts?.filter((f) => p.slug !== 'hyprfm' || f.label !== 'Stars').map((f) => <li><span>{f.label}</span><span>{f.value}</span></li>)}
        <li><span>stack</span><span>{p.stack.join(', ')}</span></li>
        <li><span>links</span><span>{p.links.map((l, k) => <>{k > 0 && ', '}<a href={l.href} target="_blank" rel="noopener">{l.label}</a></>)}</span></li>
      </ul>
    </div>
    <div>{p.body.map((t) => <p class="lead">{t}</p>)}</div>
  </section>

  {p.reception && (
    <section class="split r" data-anchor="project-reception">
      <h2 class="t2">From users</h2>
      <div>
        <ul class="quotes">
          {p.reception.quotes.map((q) => (
            <li>
              <blockquote cite={q.href}><p>“{q.text}”</p></blockquote>
              <a class="cap" href={q.href} target="_blank" rel="noopener">u/{q.author}, r/hyprland, {q.date}</a>
            </li>
          ))}
        </ul>
        <p class="cap" style="margin-top:24px">Shared on {p.reception.threads.map((t, k) => <>{k > 0 && ' and '}<a href={t.href} target="_blank" rel="noopener">{t.label}</a> ({t.stats})</>)}, September 2026.{p.reception.mentions.map((m) => <> Picked up on X by <a href={m.href} target="_blank" rel="noopener">{m.who}</a> {m.what} ({m.stats}).</>)}</p>
      </div>
    </section>
  )}

  <nav class="pn r" aria-label="Previous and next part">
    <a href={`/projects/${prev.slug}/`}><small>Previous, sheet 5.{((i - 1 + n) % n) + 1}</small><b>{prev.name}</b></a>
    <a href={`/projects/${next.slug}/`}><small>Next, sheet 5.{((i + 1) % n) + 1}</small><b>{next.name}</b></a>
  </nav>
</Layout>
