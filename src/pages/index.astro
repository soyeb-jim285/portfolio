---
import Layout from '../layouts/SchematicLayout.astro';
import { person, work, projects } from '../data/content';
const featured = projects.slice(0, 3);
const hyprfm = projects.find((p) => p.slug === 'hyprfm')!;
// Four proofs a reader can check, each linked to the sheet that backs it. Looked up, never retyped,
// so the daily star refresh and the production counts stay in one place.
const proofs = [
  { value: work.scale[0].value, label: `shopping conversations handled by ${work.product}, the assistant I build at ${work.employer}`, href: '/work/' },
  { value: String(hyprfm.stars), label: `GitHub stars on HyprFM, with ${(hyprfm.contributors ?? 1) - 1} outside contributors`, href: '/projects/hyprfm/' },
  { value: '1714', label: 'Codeforces peak, Expert. ICPC Dhaka regional finalist twice', href: '/record/' },
  { value: '2', label: 'journal papers on physics-informed ML. One published by Elsevier, one under review', href: '/research/' },
];
---
<Layout title="Soyeb Pervez Jim, drawing set" description="Portfolio of Soyeb Pervez Jim, software engineer at Fuego.io, drawn as a seven-sheet engineering set." sheet="1" big="Title sheet" stamp={{ k: 'Scale', v: 'NTS' }}>
  <section class="hero" data-anchor="home-hero">
    <div>
      <div class="dim">
        <h1>Soyeb<br>Pervez Jim</h1>
        <span class="dl">overall width</span>
      </div>
      <p class="sub">{person.tagline}</p>
      <div class="btns">
        <button type="button" class="btn fill" data-contact>Send a message</button>
        <a class="btn" href={person.links.resume} target="_blank" rel="noopener">Resume, PDF</a>
      </div>
    </div>
    <div class="fig">
      <span class="lab">FIG. A</span>
      <img src={person.portrait} alt="Soyeb Pervez Jim" width="781" height="1075" />
      <div class="cap">Subject, Dhaka. Not to scale.</div>
    </div>
  </section>

  <section class="r" data-anchor="home-proof">
    <div class="nums four">
      {proofs.map((p) => <div><a href={p.href}><strong>{p.value}</strong><span>{p.label}</span></a></div>)}
    </div>
  </section>

  <section class="split r">
    <h2>What I do</h2>
    <div>
      <p class="sub">At <a href={work.url} target="_blank" rel="noopener">{work.employer}</a> I am the {work.ownership} behind {work.product}, {work.context}: streamed chat, commerce tools, hybrid retrieval and multimodal input.</p>
      <p class="sub">On the side: biosignal classifiers for affective-computing challenges, and Linux desktop tooling in C++ and QML.</p>
      <ul class="specs">
        <li><span>day job</span><span>LLM agents, tool calling, retrieval, caching, evals</span></li>
        <li><span>research</span><span>Physics-informed models for industrial systems; physiological signal classification</span></li>
        <li><span>open source</span><span>HyprFM, hyprpdf, quill, distrostrap, a browser CNN visualiser</span></li>
        <li><span>study</span><span>{person.education}</span></li>
      </ul>
    </div>
  </section>

  <section class="r" data-anchor="home-parts">
    <div class="head" style="margin-bottom:24px">
      <h2>Projects, selected</h2>
      <p class="sub">Three of seven. <a href="/projects/">All projects, sheet 4</a>.</p>
    </div>
    <div class="parts">
      {featured.map((p, i) => (
        <a class={`part${p.image ? '' : ' plain'}`} href={`/projects/${p.slug}/`}>
          <span class="lab">ITEM {i + 1}</span>
          {p.image ? <img src={p.thumb ?? p.image} alt={`${p.name} screenshot`} loading="lazy" width="480" height="300" /> : <div class="blk" aria-hidden="true">{p.name.slice(0, 2).toUpperCase()}</div>}
          <b>{p.name}</b>
          <span>{p.kicker}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="split r">
    <h2>Contact</h2>
    <div>
      <p class="sub">Email <a href={`mailto:${person.email}`}>{person.email}</a>, or use the form. Replies usually within a day.</p>
      <div class="btns" style="margin-top:20px">
        <button type="button" class="btn fill" data-contact>Send a message</button>
        <a class="btn" href="/contact/">Sheet 7, contact</a>
      </div>
    </div>
  </section>
</Layout>
