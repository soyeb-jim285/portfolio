# Formspree-compatible endpoint. Create a form at https://formspree.io and paste its URL.
PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xdeojaqn

# Public Hono API URL. Rebuild Astro after changing this in production.
PUBLIC_API_URL=http://localhost:3001

# Cloudflare Turnstile site key (public). Production builds use soyebjim.me's key when this is unset.
# Set it empty for local builds: the real widget only renders on soyebjim.me.
# Cloudflare's always-pass test key for local work: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=
