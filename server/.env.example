# Required. Choose an OpenRouter model supporting streaming and tool calls.
OPENROUTER_API_KEY=replace-with-your-key
OPENROUTER_MODEL=replace-with-model-id

# Required. PostgreSQL holds session ownership, cached answers, rate limits and daily budgets.
DATABASE_URL=postgresql://portfolio:portfolio@localhost:55432/portfolio

SITE_ORIGIN=http://localhost:4321
HOST=127.0.0.1
# Only trust these socket peers to supply a proxy-overwritten X-Real-IP header.
# Leave empty for direct connections. Never trust arbitrary forwarded headers.
TRUSTED_PROXY_IPS=
PORT=3001
MAX_OUTPUT_TOKENS=10000
REQUEST_TIMEOUT_MS=60000
MAX_CONCURRENT_REQUESTS=3
REQUESTS_PER_MINUTE=10
MAX_REQUESTS_PER_DAY=200

# Sessions expire after this many idle days; conversation text remains in the browser.
SESSION_TTL_DAYS=7
MAX_MESSAGES_PER_SESSION=40

# Disposable database used by `npm test`; tests delete its rows and NEVER fall back to DATABASE_URL.
# TEST_DATABASE_URL=postgresql://portfolio:portfolio@localhost:55432/portfolio_test
ANSWER_CACHE_TTL_HOURS=24

# Voice notes. Any OpenRouter speech-to-text model; microsoft/mai-transcribe-2 is cheaper and tops FLEURS.
OPENROUTER_TRANSCRIPTION_MODEL=openai/gpt-4o-transcribe
TRANSCRIPTION_MAX_BYTES=8000000

# Code retrieval. Changing the model or dimensions requires a full reindex.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBEDDING_DIMS=1536
# Whose public repositories to index. A read-only token lifts GitHub's 60 requests per hour.
GITHUB_OWNER=soyeb-jim285
# GITHUB_TOKEN=github_pat_...
REPO_CACHE_DIR=.cache/repos
MAX_TOOL_STEPS=3

# Contact delivery. Without all three, the assistant says so and points at the contact page
# instead of drafting a message. CONTACT_FROM must be on a domain verified in Resend.
# RESEND_API_KEY=replace-with-your-key
# CONTACT_FROM=Portfolio Assistant <hello@yourdomain.com>
# CONTACT_TO=you@example.com
CONTACT_LABEL=Jim
CONTACT_DRAFT_TTL_MINUTES=60
CONTACT_SENDS_PER_HOUR=3
CONTACT_SENDS_PER_DAY=20

# Cloudflare Turnstile secret. Empty switches the bot check off. Set it with the site's PUBLIC_TURNSTILE_SITE_KEY.
# Cloudflare's always-pass test secret for local work: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Artifact storage. Without all four the assistant cannot generate downloadable documents.
# Use a bucket-scoped token; the bucket must stay private.
# R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# R2_BUCKET=portfolio
# R2_ACCESS_KEY_ID=replace-with-bucket-scoped-key
# R2_SECRET_ACCESS_KEY=replace-with-bucket-scoped-secret
ARTIFACT_TTL_DAYS=7
ARTIFACT_MAX_BYTES=64000
ARTIFACT_URL_TTL_SECONDS=120

# Scheduling provider: cal (Cal.com) or google (Google Calendar directly).
SCHEDULER=cal

# Cal.com. Key from Settings -> Developer -> API keys; ids from cal.com/event-types.
# One entry per bookable meeting: "<eventTypeId>:<minutes>:<label>", separated by "|".
# CAL_API_KEY=cal_live_...
# CAL_EVENT_TYPES=123456:30:Intro call|123457:15:Quick chat

# Scheduling through Google Calendar, used when SCHEDULER=google. Create an OAuth client (type: Desktop app) in Google Cloud,
# put the id and secret here, then run `npm run google:auth` once and paste the refresh token back.
# Without all three the assistant never offers a call.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REFRESH_TOKEN=...
GOOGLE_CALENDAR_ID=primary
GOOGLE_ADD_MEET=false

# Bookable meetings: "<minutes>:<label>", separated by "|".
MEETING_TYPES=30:Intro call|15:Quick chat
# Your own working hours. Slots exist only inside these, on these weekdays (0 is Sunday).
MEETING_TIME_ZONE=Asia/Dhaka
MEETING_DAYS=1,2,3,4,5
MEETING_START=09:00
MEETING_END=18:00
BOOKING_NOTICE_MINUTES=720
BOOKING_BUFFER_MINUTES=10
BOOKING_STEP_MINUTES=30
BOOKING_WINDOW_DAYS=14
BOOKING_TTL_MINUTES=60
BOOKINGS_PER_DAY=5
